# =============================================================================
#  Invoice Request Agent — configuration
# =============================================================================
#  HOW TO USE:
#    1. Copy this file to ".env"        ->  cp .env.example .env
#    2. Fill in every value marked FILL_ME below.
#    3. See docs/SETUP.md for exactly where to obtain each value.
#
#  In AWS, these same keys are stored in AWS Secrets Manager instead of a file
#  (see infra/template.yaml). Locally, this .env file is used.
#
#  >>> EVERYTHING MARKED "FILL_ME" IS SOMETHING YOU PROVIDE. <<<
# =============================================================================


# --- Runtime -----------------------------------------------------------------
# "local"  -> read config from this .env file
# "aws"    -> read config from AWS Secrets Manager (used by the Lambda)
APP_ENV=local
LOG_LEVEL=INFO

# The mailbox the agent watches and replies from.
MAILBOX_ADDRESS=invoicerequest@menteso.com


# =============================================================================
#  1) GOOGLE WORKSPACE / GMAIL   (see docs/SETUP.md section 1)
# =============================================================================
# From the OAuth client you create in Google Cloud Console.
GOOGLE_CLIENT_ID=FILL_ME
GOOGLE_CLIENT_SECRET=FILL_ME
# Produced ONCE by running:  python scripts/get_google_oauth_token.py
# (a long-lived refresh token for the invoicerequest@ mailbox)
GOOGLE_REFRESH_TOKEN=FILL_ME

# --- OR (recommended for production): service account + domain-wide delegation ---
# The durable alternative — no refresh token, never expires. If either of these is
# set, it REPLACES the OAuth values above. See docs/SETUP.md section 1 (option B).
GOOGLE_SERVICE_ACCOUNT_FILE=              # local: path to the key JSON
GOOGLE_SERVICE_ACCOUNT_JSON=              # AWS: the key JSON inline (Secrets Manager)


# =============================================================================
#  2) ZOHO CRM   (see docs/SETUP.md section 2)
# =============================================================================
# Data-center region for your Zoho account. One of: com | eu | in | com.au | jp
ZOHO_DC=com
# From the Zoho API Console (Self Client or Server-based app).
ZOHO_CLIENT_ID=FILL_ME
ZOHO_CLIENT_SECRET=FILL_ME
# Produced ONCE by running:  python scripts/get_zoho_refresh_token.py
ZOHO_REFRESH_TOKEN=FILL_ME
# The module API name that holds your Opportunities. Usually "Deals".
# Confirm with:  python scripts/inspect_zoho_module.py
ZOHO_MODULE=Deals
# The API name of your Project ID (PID) custom field inside that module.
# Confirm with:  python scripts/inspect_zoho_module.py   (e.g. "Project_ID")
ZOHO_PID_FIELD=Project_ID


# =============================================================================
#  3) WAVE   (see docs/SETUP.md section 3)
#  ** Requires a PAID Wave plan (Pro/Advisor). Free plans cannot use the API. **
# =============================================================================
# Full-access API token from the Wave developer portal.
WAVE_API_TOKEN=FILL_ME
# Your Wave business id. Get it with:  python scripts/wave_bootstrap.py
WAVE_BUSINESS_ID=FILL_ME
# The income/sales account id used for invoice line items.
# Get it with:  python scripts/wave_bootstrap.py
WAVE_INCOME_ACCOUNT_ID=FILL_ME


# =============================================================================
#  4) CLAUDE (Anthropic) — parsing fallback for messy emails
#     (see docs/SETUP.md section 4)
# =============================================================================
ANTHROPIC_API_KEY=FILL_ME
# Cheap, fast model for extraction. Leave as-is unless you have a reason to change.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# =============================================================================
#  5) AWS (only needed when APP_ENV=aws; the Lambda sets these automatically)
#     (see docs/SETUP.md section 5)
# =============================================================================
AWS_REGION=us-east-1
# Secrets Manager secret name that holds a JSON copy of all the values above.
SECRETS_MANAGER_NAME=invoice-request-agent/config
# DynamoDB table used to avoid processing the same email twice.
DDB_TABLE_NAME=invoice-request-agent-processed


# =============================================================================
#  6) REAL-TIME GMAIL PUSH (optional — Pub/Sub trigger)
#     Leave blank to use polling only. (see docs/SETUP.md section 6)
# =============================================================================
# The Pub/Sub topic Gmail publishes change notifications to.
# Format: projects/<gcp-project-id>/topics/<topic-name>
PUBSUB_TOPIC=
# OIDC audience configured on the Pub/Sub push subscription (used to verify
# that push requests really come from Google). Recommended: your push endpoint URL.
PUSH_AUDIENCE=
# The service account email Pub/Sub signs OIDC tokens with (its "email" claim).
PUSH_SA_EMAIL=
